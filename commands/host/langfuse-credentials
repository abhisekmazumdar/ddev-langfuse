#!/usr/bin/env bash

## #ddev-generated: If you want to edit and own this file, remove this line.
## Description: Show the generated Langfuse admin login and API keypair
## Usage: langfuse-credentials
## Example: "ddev langfuse-credentials"

envfile="${DDEV_APPROOT}/.ddev/.env.langfuse"

if [ ! -f "$envfile" ]; then
  echo "No .ddev/.env.langfuse found. Run 'ddev add-on get' for the langfuse add-on first."
  exit 1
fi

# shellcheck disable=SC1090
set -a
. "$envfile"
set +a

cat <<INFO
======================================================================
 Langfuse -- DDEV project: ${DDEV_SITENAME}
======================================================================
 Web UI (host browser):        ddev launch :3000  (or: ddev langfuse)
 Web UI (from other containers, e.g. Drupal web): http://langfuse-web:3000

 Admin login
   Email:    ${LANGFUSE_INIT_USER_EMAIL}
   Password: ${LANGFUSE_INIT_USER_PASSWORD}

 API keypair (project: ${LANGFUSE_INIT_PROJECT_NAME})
   Public key: ${LANGFUSE_INIT_PROJECT_PUBLIC_KEY}
   Secret key: ${LANGFUSE_INIT_PROJECT_SECRET_KEY}

 drupal/langfuse module settings
   langfuse_url:        http://langfuse-web:3000
   auth_method:         key_pair
   key_pair.public_key: ${LANGFUSE_INIT_PROJECT_PUBLIC_KEY}
   key_pair.secret_key: ${LANGFUSE_INIT_PROJECT_SECRET_KEY}
======================================================================
INFO
