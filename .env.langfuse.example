#ddev-generated
# This is a REFERENCE ONLY. The real .ddev/.env.langfuse file is generated
# automatically (with random values) by install.yaml the first time you run
# `ddev add-on get`. It is gitignored on purpose -- never commit real secrets.
#
# If you ever need to hand-edit or recreate it, this is the shape it takes:

# --- Core Langfuse secrets ---
NEXTAUTH_SECRET=changeme-random-base64
SALT=changeme-random-base64
ENCRYPTION_KEY=changeme-64-char-hex-openssl-rand--hex-32

# --- Datastore credentials ---
POSTGRES_PASSWORD=changeme
CLICKHOUSE_PASSWORD=changeme
MINIO_ROOT_PASSWORD=changeme
REDIS_AUTH=changeme

# --- Headless bootstrap: org / project / API keypair / admin user ---
LANGFUSE_INIT_ORG_ID=ddev-langfuse-org
LANGFUSE_INIT_ORG_NAME="DDEV Local"
LANGFUSE_INIT_PROJECT_ID=ddev-langfuse-project
LANGFUSE_INIT_PROJECT_NAME="Local Development"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-00000000-0000-0000-0000-000000000000
LANGFUSE_INIT_USER_EMAIL=admin@langfuse.ddev.site
LANGFUSE_INIT_USER_NAME="DDEV Admin"
LANGFUSE_INIT_USER_PASSWORD=changeme
